  flashingAnimator: {fileID: 4601502500790860199}
  dialogBox: {fileID: 49120102}
  dialogText: {fileID: 2015795234}
  dialogs:
  - Welcome to Quebec! A winter wonder land best known for ice fishing.
  - Learn the in's and outs of ice fishing and how it ties back to their ancestors.
  - Who knows you might be tested on.
  dialogActive: 0
  currentDialogIndex: 0
  petBubble: {fileID: 0}
