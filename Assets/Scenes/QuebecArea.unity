      objectReference: {fileID: 11400000, guid: a42d3fda4dae8cf42b0f0002eb1288f9, type: 2}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[0]'
      value: "Ah, bienvenue! Welcome to Quebec \u2014 where the coffee is strong
        and the winters are stronger!"
      objectReference: {fileID: 0}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[1]'
      value: "Here, you will find some of the friendliest people in Canada \u2014
        though they may greet you in French before they greet you in English!"
      objectReference: {fileID: 0}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[2]'
      value: "Do not worry if you feel a little lost \u2014 Quebec has a way of making
        everyone feel delightfully confused at first."
      objectReference: {fileID: 0}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[3]'
      value: "We are enjoying a warm tourti\xE8re \u2014 a traditional Quebec meat
        pie eaten during the winter season."
      objectReference: {fileID: 0}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[4]'
      value: "Head up \u2014 someone will help you!"
      objectReference: {fileID: 0}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[5]'
      value: Don't worry you can try again but pushing Q again
      objectReference: {fileID: 0}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[6]'
      value: Good luck!
      objectReference: {fileID: 0}
    - target: {fileID: 6610298952553556158, guid: 6f33585c79d1b3c41b5ae35e609bb957, type: 3}
      propertyPath: 'dialogs.Array.data[7]'
      value: Good luck!
      objectReference: {fileID: 0}
