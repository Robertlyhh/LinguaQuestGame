  m_Name: 
  m_EditorClassIdentifier: 
  playerInRange: 0
  context: {fileID: 11400000, guid: d34fcd4961c36a34cbd61c6313562265, type: 2}
  audioSource: {fileID: 0}
  interactSound: {fileID: 8300000, guid: 19ee79ae6541aba4ca0f0a45c0f64d89, type: 3}
  interactSignal: {fileID: 11400000, guid: df844c6a50c328e46a83e54b550dcc1b, type: 2}
  firstInteractionDone: {fileID: 11400000, guid: 338f1173988345349a89396adbcca518, type: 2}
  flashingAnimator: {fileID: 4601502501943593841}
  dialogBox: {fileID: 460128053}
  dialogText: {fileID: 1557676180}
  dialogs:
  - Hi Explorer!
  - I need to send this shipment out but everything is mixed up!
  - We need to sort the sacks before sending them out.
  - When you have gathered the information you need from this area, head to the loading
    dock.
  dialogActive: 0
  currentDialogIndex: 0
--- !u!114 &6610298952395826087
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
