  m_EditorClassIdentifier: 
  playerInRange: 0
  context: {fileID: 11400000, guid: d34fcd4961c36a34cbd61c6313562265, type: 2}
  audioSource: {fileID: 0}
  interactSound: {fileID: 8300000, guid: 19ee79ae6541aba4ca0f0a45c0f64d89, type: 3}
  interactSignal: {fileID: 11400000, guid: df844c6a50c328e46a83e54b550dcc1b, type: 2}
  firstInteractionDone: {fileID: 11400000, guid: a1ed39c4b87db4141b237096bf635a43, type: 2}
  flashingAnimator: {fileID: 4601502501991863521}
  dialogBox: {fileID: 460128053}
  dialogText: {fileID: 1557676180}
  dialogs:
  - Hey, you look new around here.
  - If someone says bunny hug, they mean a hoodie.
  - "You\u2019ll see a lot of toques too, especially in the cold."
  - "And parkas\u2026 you\u2019ll definitely need one of those."
  dialogActive: 0
  currentDialogIndex: 0
--- !u!114 &6610298952838081892
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
