  interactSound: {fileID: 8300000, guid: 19ee79ae6541aba4ca0f0a45c0f64d89, type: 3}
  interactSignal: {fileID: 11400000, guid: df844c6a50c328e46a83e54b550dcc1b, type: 2}
  firstInteractionDone: {fileID: 11400000, guid: bbb4b0568103a984c9d81e410d03b3f4, type: 2}
  flashingAnimator: {fileID: 4601502501563460015}
  dialogBox: {fileID: 460128053}
  dialogText: {fileID: 1557676180}
  dialogs:
  - Hey there!
  - Welcome to the Praries!
  - As you might have guessed, farming is a big part of life here.
  - We grow all kinds of crops, like corn, wheat, and my favourite, oats for my cereal!
  dialogActive: 1
  currentDialogIndex: 0
--- !u!114 &6610298952209153079
MonoBehaviour:
  m_ObjectHideFlags: 0
