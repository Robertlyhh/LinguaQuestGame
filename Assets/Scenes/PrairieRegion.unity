  firstInteractionDone: {fileID: 11400000, guid: af54738d7bf7c2b40b65b1768af45539, type: 2}
  flashingAnimator: {fileID: 4601502502531987039}
  dialogBox: {fileID: 460128053}
  dialogText: {fileID: 1557676180}
  dialogs:
  - You ever had a double-double before?
  - "That\u2019s just a coffee with two cream and two sugar."
  - "Poutine\u2019s another one, fries with gravy and cheese curds."
  - "And Saskatoon berry pie, that\u2019s a local thing."
  dialogActive: 0
  currentDialogIndex: 0
