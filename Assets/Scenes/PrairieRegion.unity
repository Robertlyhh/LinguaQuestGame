  interactSound: {fileID: 8300000, guid: 19ee79ae6541aba4ca0f0a45c0f64d89, type: 3}
  interactSignal: {fileID: 11400000, guid: df844c6a50c328e46a83e54b550dcc1b, type: 2}
  firstInteractionDone: {fileID: 11400000, guid: b36b70a0d40c8f14288a5998ccb8bf71, type: 2}
  flashingAnimator: {fileID: 4601502502456105506}
  dialogBox: {fileID: 460128053}
  dialogText: {fileID: 1557676180}
  dialogs:
  - Some of the words here might sound a bit strange.
  - A scrubby is just a little dishcloth
  - "And a chesterfield, that\u2019s what some people call a couch."
  - Snow brush is exactly what it sounds like, for your car.
  dialogActive: 0
  currentDialogIndex: 0
--- !u!114 &6610298952929902873
