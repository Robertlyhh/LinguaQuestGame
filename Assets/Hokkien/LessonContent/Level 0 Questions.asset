    choiceHokkienRomanizedTexts:
    - "Gu\u00E1 beh chi\u030Dt-\u00EA"
    - "Gu\u00E1 beh nn\u0304g-\u00EA"
    - "Gu\u00E1 beh sa\u207F-\u00EA"
